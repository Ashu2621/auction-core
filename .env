# Application config (docker-compose overrides DATABASE_URL, REDIS_URL, PORT)
LOG_LEVEL=info
NODE_ENV=development
ANTI_SNIPE_WINDOW_SECS=120
ANTI_SNIPE_EXTENSION_SECS=120
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=60
RATE_LIMIT_LOT_MAX=10
BUYER_PREMIUM_PCT=0.15
SETTLEMENT_RETRY_MAX=3
SETTLEMENT_RETRY_BACKOFF_MS=3600000
IDEMPOTENCY_TTL_SECS=3600

# Local development overrides (docker-compose sets these for the container)
DATABASE_URL=postgresql://auction:auction_pass@localhost:5432/auctioncore
REDIS_URL=redis://localhost:6379
PAYMENT_GATEWAY_URL=http://localhost:3001
IDENTITY_VERIFICATION_URL=http://localhost:3002
PORT=3000
